{
  "title": "Cave server",
  "views": [
    {
      "title": "Overview",
      "path": "overview",
      "icon": "mdi:view-dashboard",
      "type": "sections",
      "max_columns": 3,
      "sections": [
        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "Proxmox host",
              "icon": "mdi:server-network"
            },
            {
              "type": "entities",
              "title": "cave",
              "show_header_toggle": false,
              "entities": [
                {
                  "entity": "binary_sensor.cave_status",
                  "name": "Host online"
                },
                {
                  "entity": "sensor.cave_cpu_usage",
                  "name": "CPU"
                },
                {
                  "entity": "sensor.cave_memory_usage_percentage",
                  "name": "Memory"
                },
                {
                  "entity": "sensor.cave_disk_usage",
                  "name": "Root disk"
                },
                {
                  "entity": "binary_sensor.cave_backup_status",
              "name": "Backup health"
                },
                {
                  "entity": "sensor.cave_last_backup",
                  "name": "Last guest backup"
                }
              ]
            }
          ]
        },
        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "Guests",
              "icon": "mdi:server-outline"
            },
            {
              "type": "entities",
              "title": "LXC and VM status",
              "show_header_toggle": false,
              "state_color": true,
              "entities": [
                {
                  "entity": "binary_sensor.jellyfin_status",
                  "name": "100 \u00b7 Jellyfin"
                },
                {
                  "entity": "binary_sensor.qbittorrent_status",
                  "name": "101 \u00b7 qBittorrent"
                },
                {
                  "entity": "binary_sensor.arr_stack_status",
                  "name": "102 \u00b7 Arr stack"
                },
                {
                  "entity": "binary_sensor.jellystats_status",
                  "name": "103 \u00b7 Jellystat / Seerr"
                },
                {
                  "entity": "binary_sensor.monitoring_status",
                  "name": "104 \u00b7 Monitoring / Homarr"
                },
                {
                  "entity": "binary_sensor.immich_status",
                  "name": "105 \u00b7 Immich"
                },
                {
                  "entity": "binary_sensor.grafana_status",
                  "name": "106 \u00b7 Grafana"
                },
                {
                  "entity": "binary_sensor.influxdb_status",
                  "name": "107 \u00b7 InfluxDB"
                },
                {
                  "entity": "binary_sensor.hoa_status",
                  "name": "201 \u00b7 Home Assistant"
                }
              ]
            }
          ]
        },
        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "Storage",
              "icon": "mdi:harddisk"
            },
            {
              "type": "gauge",
              "name": "lake1t used",
              "entity": "sensor.storage_lake1t_storage_usage_percentage",
              "min": 0,
              "max": 100,
              "severity": {
                "green": 0,
                "yellow": 75,
                "red": 90
              }
            },
            {
              "type": "gauge",
              "name": "SSD local-lvm used",
              "entity": "sensor.storage_local_lvm_storage_usage_percentage",
              "min": 0,
              "max": 100,
              "severity": {
                "green": 0,
                "yellow": 75,
                "red": 90
              }
            },
            {
              "type": "gauge",
              "name": "Backup pool used",
              "entity": "sensor.storage_cave_backups_storage_usage_percentage",
              "min": 0,
              "max": 100,
              "severity": {
                "green": 0,
                "yellow": 75,
                "red": 90
              }
            },
            {
              "type": "entities",
              "title": "Pool availability",
              "show_header_toggle": false,
              "entities": [
                {
                  "entity": "binary_sensor.storage_lake1t_storage_active",
                  "name": "lake1t active"
                },
                {
                  "entity": "binary_sensor.storage_local_lvm_storage_active",
                  "name": "local-lvm active"
                },
                {
                  "entity": "binary_sensor.storage_cave_backups_storage_active",
                  "name": "Backup pool active"
                }
              ]
            }
          ]
        }
      ]
